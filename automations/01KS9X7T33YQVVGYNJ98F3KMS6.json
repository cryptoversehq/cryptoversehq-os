{
  "version": "2",
  "flowTitle": "CryptoVerse HQ — Verify Email",
  "trigger": {
    "valid": true,
    "type": "WEBHOOK",
    "settings": {
      "input": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Input for code"
          },
          "email": {
            "type": "string",
            "description": "Input for email"
          },
          "displayName": {
            "type": "string",
            "description": "Input for displayName"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "actions": [
    {
      "name": "d12681dd-579e-41f3-a090-ade8e6aa39a2",
      "valid": false,
      "displayName": "Send Verification Email via Gmail",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-piece-gmail",
        "pieceVersion": "1.0.0",
        "actionName": "sendEmail",
        "input": {
          "to": "{{ trigger[\"body\"][\"email\"] }}",
          "subject": "CryptoVerse AI — Confirm your email address",
          "bodyHtml": "<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{margin:0;padding:0;background:#0d1117;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.wrapper{background:#0d1117;padding:40px 20px}.card{background:#111827;border:1px solid #1f2937;border-radius:16px;padding:40px;max-width:480px;margin:0 auto}.greeting{color:#e5e7eb;font-size:16px;margin-bottom:8px}.body-text{color:#9ca3af;font-size:14px;line-height:1.6;margin-bottom:28px}.code-box{background:#1f2937;border:2px solid rgba(245,158,11,0.25);border-radius:12px;padding:24px;text-align:center;margin-bottom:24px}.code-label{color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px}.code{color:#f59e0b;font-size:40px;font-weight:800;letter-spacing:12px}.expiry{color:#6b7280;font-size:12px;margin-top:8px}.warning{background:#1f2937;border-radius:8px;padding:12px 16px;margin-bottom:24px}.warning-text{color:#6b7280;font-size:12px;line-height:1.5}.footer{text-align:center;color:#374151;font-size:11px;margin-top:24px;padding-top:24px;border-top:1px solid #1f2937}</style></head><body><div class='wrapper'><div class='card'><div style='text-align:center;margin-bottom:28px'><div style='display:inline-block;width:52px;height:52px;background:linear-gradient(135deg,#f59e0b,#f97316);border-radius:14px;font-size:28px;line-height:52px;text-align:center;margin-bottom:10px'>⚡</div><div style='color:#fff;font-size:22px;font-weight:800'>CryptoVerse AI</div><div style='color:#f59e0b;font-size:12px;margin-top:2px'>Trade. Learn. Compete.</div></div><div class='greeting'>Welcome, {{ trigger[\"body\"][\"displayName\"] }} 👋</div><div class='body-text'>Thanks for joining CryptoVerse AI! Please verify your email address using the 6-digit code below to activate your account and start trading.</div><div class='code-box'><div class='code-label'>Email verification code</div><div class='code'>{{ trigger[\"body\"][\"code\"] }}</div><div class='expiry'>Expires in 5 minutes</div></div><div class='warning'><div class='warning-text'>Never share this code with anyone. CryptoVerse AI will never ask for your code via phone or chat.</div></div><div class='footer'>2025 CryptoVerse AI - Trade smarter, not harder. This is an automated message, please do not reply.</div></div></div></body></html>"
        }
      }
    }
  ],
  "outputs": [
    {
      "type": "http_response",
      "body": {
        "type": "json",
        "data": {
          "type": "basic",
          "payload": [
            {
              "ok": "true"
            }
          ]
        }
      },
      "key": "trigger"
    }
  ]
}